# Puerto donde escucha el servidor HTTP + WebSocket
PORT=3000

# Orígenes permitidos para conectarse por WebSocket, separados por comas.
# En local, el propio servidor sirve el cliente en el mismo origen, así que
# basta con la URL desde la que abres el navegador.
ALLOWED_ORIGINS=http://localhost:3000

# Tamaño máximo del historial de mensajes que se guarda en memoria
MAX_HISTORY=50

# Longitud máxima de un mensaje
MAX_MESSAGE_LENGTH=500

# Límite de ritmo: mensajes permitidos por ventana de tiempo
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=5000
